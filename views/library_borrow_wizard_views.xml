<odoo>
    <record id="view_library_borrow_wizard_form" model="ir.ui.view">
        <field name="name">library.borrow.wizard.form</field>
        <field name="model">library.borrow.wizard</field>
        <field name="arch" type="xml">
            <form string="Borrow Book(s)">
                <group>
                    <field name="book_ids" widget="many2many_tags"/>
                    <field name="borrower_id"/>
                </group>
                <footer>
                    <button name="action_confirm_borrow" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_library_borrow_wizard" model="ir.actions.act_window">
        <field name="name">Borrow Selected Books</field>
        <field name="res_model">library.borrow.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_library_book"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>