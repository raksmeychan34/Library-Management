<odoo>

    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books" decoration-danger="is_overdue">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="publish_date"/>
                <field name="pages"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'draft'"
                    decoration-warning="state == 'borrowed'"
                    decoration-info="state == 'returned'"/>
                <field name="is_overdue"/>
                <field name="borrower_id"/>
            </list>
        </field>
    </record>

    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button name="%(action_library_borrow_wizard)d" type="action" string="Borrow"
                            invisible="state != 'draft'" class="btn-primary"
                            context="{'default_book_ids': [id]}"/>
                    <button name="action_return" type="object" string="Return"
                            invisible="state != 'borrowed'" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,borrowed,returned"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="isbn"/>
                        <field name="publish_date"/>
                        <field name="pages"/>
                        <field name="description"/>
                        <field name="loan_period_days"/>
                        <field name="is_overdue"/>
                        <field name="borrower_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Books">
                <field name="name"/>
                <field name="borrower_id"/>
                <filter string="Available" name="filter_available" domain="[('state', '!=', 'borrowed')]"/>
                <filter string="Borrowed" name="state_borrowed" domain="[('state', '=', 'borrowed')]"/>
                <filter string="Returned" name="state_returned" domain="[('state', '=', 'returned')]"/>
                <filter string="Overdue" name="filter_overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <filter string="Group by Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Group by Borrower" name="group_borrower" context="{'group_by': 'borrower_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_library_book_kandan" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">  <!-- (attribute)the board opens already grouped into Draft/Borrowed/Returned columns-->
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="publish_date"/>
                <field name="pages"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">   <!-- Kanban card template -->
                        <div class="oe_kandan_card oe_kandan_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="author"/></div>
                            <div t-if="record.borrower_id.value">   <!--only shows the "Borrower" line-->
                                Borrower: <field name="borrower_id"/>
                            </div>
                        </div>
                    </t>
                </templates>               
            </kanban>
        </field>
    </record>

    <record id="view_library_pivot" model="ir.ui.view">
        <field name="name">library.book.pivot</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <pivot string="Borrowing Activity">
                <field name="borrow_date" interval="month" type="row"/>
                <field name="state" type="col"/>
                <field name="is_overdue" />
            </pivot>
        </field>
    </record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,kanban,pivot,form</field>
        <field name="search_view_id" ref="view_library_book_search"/>
    </record>

    <menuitem id="menu_library_book"
              name="Books"
              parent="menu_library_root"
              action="action_library_book"
    />
</odoo>